  },
  {
    "id": "663ea1bfffe5038f",
    "text": "to",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "3e6579f023172d2b",
    "text": "unscrew them carefully",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "b3d365f7b39223cd",
    "text": "Figure 5",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "64697b44a72087af",
    "text": "Avoid dropping screws",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "74d77d94f1a062c1",
    "text": ", as they may cause damage.",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "c6eff9d6b64411ed",
    "text": "\"A dropped part will always land where it can do the most damage.\"",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "09c4697bfa7a58d9",
    "text": "– Sod/Murphy’s Law",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "a014f968ba198e0d",
    "text": "2.5 Transferring Components to the New Mainboard",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "5ad182d21c86b5d1",
    "text": "SD card and drivers",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "b8f50d00837e15cc",
    "text": "from the old mainboard.",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "1703a4592684da16",
    "text": "Install them onto the new mainboard",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "4313ee8345cf38df",
    "text": "3. Installing the New Mainboard",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "d1836c2ceaef945d",
    "text": "3.1 Mounting the Mainboard",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "b46bb91ca9d271c4",
    "text": "Align the",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "4158452d4c3b1305",
    "text": "new mainboard",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "61c8a08976f7df1d",
    "text": "in place.",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "bdc4a7e0b4f55f9b",
    "text": "Secure it with screws",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "31b656a01791c002",
    "text": "using a",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "6d1c7bd85696ed8d",
    "text": "3.2 Reconnecting the Wi-Fi Antenna",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "b2c037ddff0cf1af",
    "text": "Use tweezers to position the",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "6d496f74eabb94ae",
    "text": "over its socket.",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "fdce5da2cec2ff02",
    "text": "Keep it",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "98ccdbc9f7c0b034",
    "text": "parallel to the mainboard",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "09960594ce010c78",
    "text": ", then press it",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "9c0c66e7568a289d",
    "text": "firmly into place",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "e4676f7d08752916",
    "text": "flat-end Allen key",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "c8fe1d752710310f",
    "text": "works well for this task.",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "d919d0ea5eb37feb",
    "text": "3.3 Reconnecting All Cables",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "02e3217ea788debf",
    "text": "Starting from the right side",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "7be905f40034de1f",
    "text": ", reconnect each cable to its corresponding header.",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "f98d44c022f4d680",
    "text": "Use the diagram in Figure 5",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
