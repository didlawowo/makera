[
  {
    "id": "6201111b83a0cb5b",
    "text": "and",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "19eef136007b7669",
    "text": "emergency stop (E-stop) button",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "0815fcca4608a2fd",
    "text": "Turn on the machine",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "f6f90b0e2397d547",
    "text": "4.2 Connecting to the Carvera Wi-Fi",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "95ee01d344fbf074",
    "text": "On your",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "f81242d5a4fe9999",
    "text": "PC or mobile device",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "4c79a51dfddcf963",
    "text": ", search for available",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "cb4ec95a3f558913",
    "text": "Wi-Fi networks",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "ba8e707893ae6451",
    "text": "Locate and",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "ac5d57fdd496dfca",
    "text": "connect to the Carvera Wi-Fi network",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "12f996c2966ca03e",
    "text": ", which appears as:",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "87032965b5ce548c",
    "text": "\"Carvera_WiFi_",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "f5cad8a908aa757f",
    "text": "Figure 6",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "aa103a65a8ffb453",
    "text": "Open the",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "acad47055f0f380d",
    "text": "Carvera Controller App",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "ba9fe13028b02010",
    "text": "Search for your Carvera machine",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "5a638a128ca67348",
    "text": "connect",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "ef000543bc3239e1",
    "text": "Figure 7",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "3374e72f56e15d02",
    "text": "4.3 Connecting to Your Local Network",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "a33787c544cc6eec",
    "text": "Tools menu",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "32df29f9a28cf0a0",
    "text": "Figure 8",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "8b43c2f0a7ff82b8",
    "text": "Select the",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "984b0e1f32bb5a9c",
    "text": "Wi-Fi symbol",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "f5109ac0ddeab9e7",
    "text": "Choose your",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "9a7fd0421dd8abe6",
    "text": "local network (Figure 9).",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "d093d03696a5c4c6",
    "text": "If prompted,",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "6935b473355933d5",
    "text": "enter your Wi-Fi password",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "3c995e4934562a26",
    "text": "Once connected,",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "79937616a945ebda",
    "text": "reconnect your PC or phone to your normal network",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "56a00912d122bc9e",
    "text": "5. Final Steps & Verification",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "d7d10b9e4ddf20c2",
    "text": "Securely close the back panel",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "6a014856b5db1feb",
    "text": "Verify that the machine powers on and connects properly",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "c9ac863cc661b428",
    "text": "Your Carvera Air mainboard replacement is now complete! ✅",
    "page": "https://wiki.makera.com/en/Air/Maintenance/Mainboard_replacement"
  },
  {
    "id": "c2e88de423a7f466",
    "text": "Turn on or off the buzzer",
    "page": "https://wiki.makera.com/en/Air/Maintenance/beep-on-off"
  },
  {
    "id": "5014da31a19ea626",
    "text": "How to turn on or off the buzzer:",
    "page": "https://wiki.makera.com/en/Air/Maintenance/beep-on-off"
  },
  {
    "id": "c3edd234ed8e3e7a",
    "text": "1. Turn off the buzzer.",
    "page": "https://wiki.makera.com/en/Air/Maintenance/beep-on-off"
  },
  {
    "id": "29d7a9dec2074269",
    "text": "Input '",
    "page": "https://wiki.makera.com/en/Air/Maintenance/beep-on-off"
  },
  {
    "id": "f3eb471859aff3c7",
    "text": "' in the MDI window, and then click the",
    "page": "https://wiki.makera.com/en/Air/Maintenance/beep-on-off"
  },
  {
    "id": "cab9ac5a7380144d",
    "text": "config-set sd switch.beep.enable false",
    "page": "https://wiki.makera.com/en/Air/Maintenance/beep-on-off"
  },
  {
    "id": "743b53ee65674452",
    "text": ". If the setting is successful, the message bar will return 'sd: switch.beep.enable has been set to false'.",
    "page": "https://wiki.makera.com/en/Air/Maintenance/beep-on-off"
  },
  {
    "id": "4db7288ea45d39b1",
    "text": "'send' button",
    "page": "https://wiki.makera.com/en/Air/Maintenance/beep-on-off"
  },
  {
    "id": "cef6734e9409005e",
    "text": "Turn off the power to the machine and then turn it back on.",
    "page": "https://wiki.makera.com/en/Air/Maintenance/beep-on-off"
  },
  {
    "id": "ceffd83c3d8dadbd",
    "text": "After the modification, the buzzer will only sound once when the machine is initially powered on, and it will not sound again at other times.",
    "page": "https://wiki.makera.com/en/Air/Maintenance/beep-on-off"
  },
  {
    "id": "26db8a2ba1f86143",
    "text": "2. Turn on the buzzer.",
    "page": "https://wiki.makera.com/en/Air/Maintenance/beep-on-off"
  },
  {
    "id": "37e7d93bf21d9863",
    "text": "config-set sd switch.beep.enable true",
    "page": "https://wiki.makera.com/en/Air/Maintenance/beep-on-off"
  },
  {
    "id": "fdc5352a2c5ab5e0",
    "text": ". If the setting is successful, the message bar will return 'sd: switch.beep.enable has been set to true'.",
    "page": "https://wiki.makera.com/en/Air/Maintenance/beep-on-off"
  },
  {
    "id": "610c0b0f02c21677",
    "text": "After modification, the buzzer will sound when the machine is powered on, issues warnings, errors, automatic tool change prompts, and when the machining task is completed.",
    "page": "https://wiki.makera.com/en/Air/Maintenance/beep-on-off"
  },
  {
    "id": "27385d2279ec3c81",
    "text": "Replacing the Top Polycarbonate Cover of the Carvera Air",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "c6a6a924be0766b5",
    "text": "Tools Required",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "e157ba239b9b8123",
    "text": "Sticky tape",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "cf2befb0f1a62829",
    "text": "Preparation",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "c45f0f31750853c7",
    "text": "Secure the Top Button",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "d21f499e0c3ce981",
    "text": "– Before starting, place a piece of",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "a76f96872e13a459",
    "text": "sticky tape",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "09ec881fcdeecceb",
    "text": "over the",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "a346ac909950b3da",
    "text": "top button",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "d4a762a8c5ac1b6e",
    "text": "to prevent it from falling out during the process (",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "fb9a761b9a123291",
    "text": "Disassembly Process",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "13262bb18fe5aeed",
    "text": "Step 1: Remove the Screws",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "f149be88a8697c25",
    "text": "Using the",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "599f92751b7795d1",
    "text": "remove the screws",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "e24a96874958488d",
    "text": "securing the top poly-carbonate cover (",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "19427a1487d97dc2",
    "text": "Manually move the spindle",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "2a3ddbb77fe70960",
    "text": "to gain access to all screws. For safety purposes, ensure that the machine is powered off before attempting this step  (",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  },
  {
    "id": "e968473a0432d4f8",
    "text": "Step 2: Remove the Side Screws",
    "page": "https://wiki.makera.com/en/Air/Maintenance/replace_polycarb_top"
  }
]
