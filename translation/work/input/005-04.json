[
  {
    "id": "b837b360424a8da1",
    "text": "grub screws",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "13262a3c3f156ff5",
    "text": "securing the collet lever shaft.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "fa602e3d717f71f3",
    "text": "Using a",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "ad82fcb7aa13e1a8",
    "text": ", remove the",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "a7c7f48f63f52167",
    "text": "front grub screw",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "efd4b3264fa300f3",
    "text": "Similarly, remove the",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "6a3982c585375423",
    "text": "rear grub screw",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "366f01b43b3b4517",
    "text": "as indicated in",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "6bbde193b732b4f1",
    "text": "Step 2: Remove the Collet Release Lever",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "509605ce24837fd6",
    "text": "With the grub screws removed,",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "d72f0dad34d54978",
    "text": "lift the collet release lever upward and out",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "9fb9ee8dc55cca60",
    "text": "of the collet lever shaft.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "3240c78dfd6f765d",
    "text": "Ensure that no debris or obstructions are present before proceeding to the next step.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "c758265c36125b4c",
    "text": "Step 3: Tighten the Shaft Securing Screw",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "becf83b1d7deb649",
    "text": "Looking from the",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "133b67d69eebb0ee",
    "text": "left side",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "869334dcaf720260",
    "text": ", locate the",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "89b0f339c1b7c35e",
    "text": "central hole in the collet lever shaft",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "d62f42fcc6f58e12",
    "text": "Inside this hole, identify the",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "91a627e411d7c240",
    "text": "2.5mm Allen screw",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "bf2dbf1a0a47b7e2",
    "text": "that secures the shaft in place (",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "05f053d780f95735",
    "text": "tighten",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "30a048a72d423023",
    "text": "this screw, ensuring the shaft is firmly secured.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "7cc834877744fc78",
    "text": "Step 4: Reinstall the Collet Release Lever",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "5b9d793f2dd8926a",
    "text": "Position the collet release lever back onto the shaft.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "c144c09c51ea1cd2",
    "text": "Insert and",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "e10c6f521db824ec",
    "text": "tighten the grub screws",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "0c2cafeaf24ab254",
    "text": ", ensuring they are properly seated in the",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "75940ab215c74a87",
    "text": "small locating hole near the end of the shaft",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "c907a425c9e808bb",
    "text": "Confirm that the collet lever moves freely without excessive play.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "c6d656e1c7f8f74d",
    "text": "Ensure all screws are securely fastened to prevent future loosening.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "1a910afe75f92451",
    "text": "Test the functionality before returning the machine to operation.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/collet_lever"
  },
  {
    "id": "86fc1c8c22898a3f",
    "text": "Adjusting the Z-Axis Rails",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "764fc2948988d0e9",
    "text": "(included in the tool kit)",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "736e072d9b2bbb47",
    "text": "Step 1: Preparation",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "9b7b2598110fb2d2",
    "text": "Ensure that the",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "ea0bdaf4d8444a52",
    "text": "before beginning the adjustment.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "a74590ef211b0481",
    "text": "two screws to the left of the spindle head",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "6ff5308cf28e03a3",
    "text": "(Figures 1 and 2).",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "c866620dad653f53",
    "text": "Step 2: Loosening the Screws",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "30687c918629c83a",
    "text": "loosen the two screws",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "60941c783023b886",
    "text": "securing the Z-axis rails. Do not remove them completely.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "ef9fe130b3dfd4dd",
    "text": "Step 3: Adjusting the Spindle Head",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "71cfd4bc2177cacc",
    "text": "Gently push the spindle head down by hand",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "608e7d287d7cfa2f",
    "text": "(Figure 3).",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "8d919f33c93d1dab",
    "text": "Be cautious not to allow the spindle head to",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "8ac4213bac176dc0",
    "text": "crash into the auto tool setter",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "bbd786d5b0bc3cd1",
    "text": "(Figure 4)",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "22a122b66658dd0f",
    "text": "Step 4: Securing the Adjustment",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "2bd2613dfeb22ac7",
    "text": "With the spindle head in its",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "765189980235e5c0",
    "text": "lowest position",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "aa419379cfd6daa3",
    "text": "re-tighten the screws",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "007a74feb220acc4",
    "text": "(Figures 5 and 6).",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "58f1b7d64ab2a19d",
    "text": "Avoid over tightening, as this may cause binding in the movement.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "d8953388162adfd1",
    "text": "Step 5: Testing the Adjustment",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "e2f43dccc587e7a7",
    "text": "Manually slide the spindle head up and down",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "f33a1854eefcb334",
    "text": "to ensure smooth movement.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "cab8a9cadca2aa6d",
    "text": "Verify that there is",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "bc05a76fb7df7792",
    "text": "no play or backlash",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "5eb5e2f38da310ac",
    "text": "in the Z-axis movement.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "56ae73d00a1b2346",
    "text": "Confirm that the spindle head moves smoothly.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "ecca47fb20b92f7b",
    "text": "Ensure that the Z-axis rails are properly secured without excessive tension.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "eaa2f86e4cef89ec",
    "text": "Restart the machine and perform a test operation to verify proper function.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "af4d4a48a59fe27d",
    "text": "The Z-axis rail adjustment is now complete.",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/linear_rail_adjustment"
  },
  {
    "id": "1fd9094cc7d22e17",
    "text": "Machine is halted X, Y, Z Axis Motor Error, reset needed",
    "page": "https://wiki.makera.com/en/Air/Troubleshooting/xyzaxismotorerror"
  }
]
