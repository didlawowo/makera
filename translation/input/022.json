    "page": "https://wiki.makera.com/en/speeds-and-feeds"
  },
  {
    "id": "6d0d264e16c4c8d6",
    "text": "Composites",
    "page": "https://wiki.makera.com/en/speeds-and-feeds"
  },
  {
    "id": "86427847ffa07e44",
